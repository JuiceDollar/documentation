<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # VuePress generates /path.html alongside /path/ directories for pages with
  # children (e.g. positions.html + positions/). Without these rules, requesting
  # /path or /path/ returns 403 because the directory lacks an index.html.

  # /path -> internally serve /path.html (no visible redirect)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]

  # /path/ -> redirect to /path.html (trailing slash case)
  RewriteCond %{REQUEST_URI} ^/(.+)/$
  RewriteCond %{DOCUMENT_ROOT}/%1.html -f
  RewriteRule ^ /%1.html [L,R=301]
</IfModule>
